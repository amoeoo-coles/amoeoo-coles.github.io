# EXAMPLE terraform.tfvars — placeholders only. Copy to a private repo and
# replace via secrets or a gitignored tfvars file. Never commit real passwords.

apic_url      = "https://apic.example.invalid"
apic_username = "{{ apic_username }}"
apic_password = "{{ apic_password }}"

ndo_url       = "https://nd.example.invalid"
ndo_username  = "{{ ndo_username }}"
ndo_password  = "{{ ndo_password }}"

nxos_url      = "https://ipn1.example.invalid"
nxos_username = "{{ nxos_username }}"
nxos_password = "{{ nxos_password }}"
