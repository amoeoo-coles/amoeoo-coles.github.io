# 370 · resource fmc_device_subinterface · 4. Devices
# This resource manages a Device Subinterface.
# Reads models/fmc_device_subinterface.yml with yamldecode(file(...)). Provider block: ../providers.tf
# Provider CiscoDevNet/fmc 2.8.0. Credentials come from variables only.

locals {
  m_370 = yamldecode(file("${path.module}/../models/fmc_device_subinterface.yml"))["fmc_device_subinterface"]
}

