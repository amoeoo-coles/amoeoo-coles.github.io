# 271 · resource fmc_access_rule · 3. Policies
# This resource manages an Access Rule.
# Reads models/fmc_access_rule.yml with yamldecode(file(...)). Provider block: ../providers.tf
# Provider CiscoDevNet/fmc 2.8.0. Credentials come from variables only.

locals {
  m_271 = yamldecode(file("${path.module}/../models/fmc_access_rule.yml"))["fmc_access_rule"]
}

resource "fmc_access_rule" "n271" {
  access_control_policy_id     = local.m_271["access_control_policy_id"]
  action                       = local.m_271["action"]
  application_filter_objects   = local.m_271["application_filter_objects"]
  application_filters          = local.m_271["application_filters"]
  applications                 = local.m_271["applications"]
  category_name                = local.m_271["category_name"]
  description                  = local.m_271["description"]
  destination_dynamic_objects  = local.m_271["destination_dynamic_objects"]
  destination_network_literals = local.m_271["destination_network_literals"]
  destination_network_objects  = local.m_271["destination_network_objects"]
  destination_port_literals    = local.m_271["destination_port_literals"]
  destination_port_objects     = local.m_271["destination_port_objects"]
  destination_sgt_objects      = local.m_271["destination_sgt_objects"]
  destination_zones            = local.m_271["destination_zones"]
  domain                       = local.m_271["domain"]
  enabled                      = local.m_271["enabled"]
  endpoint_device_types        = local.m_271["endpoint_device_types"]
  file_policy_id               = local.m_271["file_policy_id"]
  insert_after_rule            = local.m_271["insert_after_rule"]
  insert_before_rule           = local.m_271["insert_before_rule"]
  intrusion_policy_id          = local.m_271["intrusion_policy_id"]
  log_connection_begin         = local.m_271["log_connection_begin"]
  log_connection_end           = local.m_271["log_connection_end"]
  log_files                    = local.m_271["log_files"]
  name                         = local.m_271["name"]
  section                      = local.m_271["section"]
  send_events_to_fmc           = local.m_271["send_events_to_fmc"]
  send_syslog                  = local.m_271["send_syslog"]
  snmp_alert_id                = local.m_271["snmp_alert_id"]
  source_dynamic_objects       = local.m_271["source_dynamic_objects"]
  source_network_literals      = local.m_271["source_network_literals"]
  source_network_objects       = local.m_271["source_network_objects"]
  source_port_literals         = local.m_271["source_port_literals"]
  source_port_objects          = local.m_271["source_port_objects"]
  source_sgt_objects           = local.m_271["source_sgt_objects"]
  source_zones                 = local.m_271["source_zones"]
  syslog_alert_id              = local.m_271["syslog_alert_id"]
  syslog_severity              = local.m_271["syslog_severity"]
  time_range_id                = local.m_271["time_range_id"]
  url_categories               = local.m_271["url_categories"]
  url_literals                 = local.m_271["url_literals"]
  url_objects                  = local.m_271["url_objects"]
  variable_set_id              = local.m_271["variable_set_id"]
  vlan_tag_literals            = local.m_271["vlan_tag_literals"]
  vlan_tag_objects             = local.m_271["vlan_tag_objects"]
}
