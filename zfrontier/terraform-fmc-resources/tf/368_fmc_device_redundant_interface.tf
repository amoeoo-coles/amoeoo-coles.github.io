# 368 · resource fmc_device_redundant_interface · 4. Devices
# This resource manages a Device Redundant Interface.
# Reads models/fmc_device_redundant_interface.yml with yamldecode(file(...)). Provider block: ../providers.tf
# Provider CiscoDevNet/fmc 2.8.0. Credentials come from variables only.

locals {
  m_368 = yamldecode(file("${path.module}/../models/fmc_device_redundant_interface.yml"))["fmc_device_redundant_interface"]
}

