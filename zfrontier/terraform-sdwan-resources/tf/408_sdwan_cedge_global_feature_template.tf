# 408 · resource sdwan_cedge_global_feature_template · 11. (Classic) feature templates
# This resource can manage a cEdge Global feature template. Minimum SD-WAN Manager version: 15.0.0
# Reads models/sdwan_cedge_global_feature_template.yml with yamldecode(file(...)). Provider block: ../providers.tf
# Provider CiscoDevNet/sdwan 0.12.0. Credentials come from variables only.

locals {
  m_408 = yamldecode(file("${path.module}/../models/sdwan_cedge_global_feature_template.yml"))["sdwan_cedge_global_feature_template"]
}

resource "sdwan_cedge_global_feature_template" "n408" {
  arp_proxy                     = local.m_408["arp_proxy"]
  arp_proxy_variable            = local.m_408["arp_proxy_variable"]
  bootp                         = local.m_408["bootp"]
  bootp_variable                = local.m_408["bootp_variable"]
  cdp                           = local.m_408["cdp"]
  cdp_variable                  = local.m_408["cdp_variable"]
  console_logging               = local.m_408["console_logging"]
  console_logging_variable      = local.m_408["console_logging_variable"]
  description                   = local.m_408["description"]
  device_types                  = local.m_408["device_types"]
  domain_lookup                 = local.m_408["domain_lookup"]
  domain_lookup_variable        = local.m_408["domain_lookup_variable"]
  ftp_passive                   = local.m_408["ftp_passive"]
  ftp_passive_variable          = local.m_408["ftp_passive_variable"]
  http_authentication           = local.m_408["http_authentication"]
  http_authentication_variable  = local.m_408["http_authentication_variable"]
  http_server                   = local.m_408["http_server"]
  http_server_variable          = local.m_408["http_server_variable"]
  https_server                  = local.m_408["https_server"]
  https_server_variable         = local.m_408["https_server_variable"]
  ip_source_routing             = local.m_408["ip_source_routing"]
  ip_source_routing_variable    = local.m_408["ip_source_routing_variable"]
  line_vty                      = local.m_408["line_vty"]
  line_vty_variable             = local.m_408["line_vty_variable"]
  lldp                          = local.m_408["lldp"]
  lldp_variable                 = local.m_408["lldp_variable"]
  name                          = local.m_408["name"]
  nat64_tcp_timeout             = local.m_408["nat64_tcp_timeout"]
  nat64_tcp_timeout_variable    = local.m_408["nat64_tcp_timeout_variable"]
  nat64_udp_timeout             = local.m_408["nat64_udp_timeout"]
  nat64_udp_timeout_variable    = local.m_408["nat64_udp_timeout_variable"]
  rsh_rcp                       = local.m_408["rsh_rcp"]
  rsh_rcp_variable              = local.m_408["rsh_rcp_variable"]
  snmp_ifindex_persist          = local.m_408["snmp_ifindex_persist"]
  snmp_ifindex_persist_variable = local.m_408["snmp_ifindex_persist_variable"]
  source_interface              = local.m_408["source_interface"]
  source_interface_variable     = local.m_408["source_interface_variable"]
  ssh_version                   = local.m_408["ssh_version"]
  ssh_version_variable          = local.m_408["ssh_version_variable"]
  tcp_keepalives_in             = local.m_408["tcp_keepalives_in"]
  tcp_keepalives_in_variable    = local.m_408["tcp_keepalives_in_variable"]
  tcp_keepalives_out            = local.m_408["tcp_keepalives_out"]
  tcp_keepalives_out_variable   = local.m_408["tcp_keepalives_out_variable"]
  tcp_small_servers             = local.m_408["tcp_small_servers"]
  tcp_small_servers_variable    = local.m_408["tcp_small_servers_variable"]
  udp_small_servers             = local.m_408["udp_small_servers"]
  udp_small_servers_variable    = local.m_408["udp_small_servers_variable"]
  vty_logging                   = local.m_408["vty_logging"]
  vty_logging_variable          = local.m_408["vty_logging_variable"]
}
