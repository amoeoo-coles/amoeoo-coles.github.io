# 460 · resource sdwan_cisco_vpn_interface_ipsec_feature_template · 11. (Classic) feature templates
# This resource can manage a Cisco VPN Interface IPSec feature template. Minimum SD-WAN Manager version: 15.0.0
# Reads models/sdwan_cisco_vpn_interface_ipsec_feature_template.yml with yamldecode(file(...)). Provider block: ../providers.tf
# Provider CiscoDevNet/sdwan 0.12.0. Credentials come from variables only.

locals {
  m_460 = yamldecode(file("${path.module}/../models/sdwan_cisco_vpn_interface_ipsec_feature_template.yml"))["sdwan_cisco_vpn_interface_ipsec_feature_template"]
}

resource "sdwan_cisco_vpn_interface_ipsec_feature_template" "n460" {
