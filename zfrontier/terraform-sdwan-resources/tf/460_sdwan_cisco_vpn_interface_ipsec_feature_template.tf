  ike_group = local.m_460["ike_group"]
  ike_group_variable = local.m_460["ike_group_variable"]
  ike_mode = local.m_460["ike_mode"]
  ike_mode_variable = local.m_460["ike_mode_variable"]
  ike_pre_shared_key = try(var.secrets["sdwan_cisco_vpn_interface_ipsec_feature_template.ike_pre_shared_key"], local.m_460["ike_pre_shared_key"])
