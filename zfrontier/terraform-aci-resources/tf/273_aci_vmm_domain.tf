# 273 · resource aci_vmm_domain · 2. Access policies
# Manages ACI VMM Domain
# APIC class: vmmDomP · DN: uni/vmmp-{vendor}/dom-{name}
# Reads models/aci_vmm_domain.yml with yamldecode(file(...)). Provider block: ../providers.tf
# Provider CiscoDevNet/aci 2.21.0. Credentials come from variables only.

locals {
  m_273 = yamldecode(file("${path.module}/../models/aci_vmm_domain.yml"))["aci_vmm_domain"]
}

resource "aci_vmm_domain" "n273" {
  access_mode                           = local.m_273["access_mode"]
  annotation                            = local.m_273["annotation"]
  annotations                           = local.m_273["annotations"]
  arp_learning                          = local.m_273["arp_learning"]
  ave_time_out                          = local.m_273["ave_time_out"]
  config_infra_pg                       = local.m_273["config_infra_pg"]
  configure_infra_port_groups           = local.m_273["configure_infra_port_groups"]
  ctrl_knob                             = local.m_273["ctrl_knob"]
  custom_switch_name                    = local.m_273["custom_switch_name"]
  default_encapsulation_mode            = local.m_273["default_encapsulation_mode"]
  delimiter                             = local.m_273["delimiter"]
  enable_ave                            = local.m_273["enable_ave"]
  enable_ave_mode                       = local.m_273["enable_ave_mode"]
  enable_tag                            = local.m_273["enable_tag"]
  enable_tag_collection                 = local.m_273["enable_tag_collection"]
  enable_vm_folder                      = local.m_273["enable_vm_folder"]
  enable_vm_folder_data_retrieval       = local.m_273["enable_vm_folder_data_retrieval"]
  encap_mode                            = local.m_273["encap_mode"]
  encapsulation_mode                    = local.m_273["encapsulation_mode"]
  endpoint_data_path_verification       = local.m_273["endpoint_data_path_verification"]
  endpoint_inventory_type               = local.m_273["endpoint_inventory_type"]
  endpoint_retention_time               = local.m_273["endpoint_retention_time"]
  enf_pref                              = local.m_273["enf_pref"]
  ep_inventory_type                     = local.m_273["ep_inventory_type"]
  ep_ret_time                           = local.m_273["ep_ret_time"]
  host_availability_assurance           = local.m_273["host_availability_assurance"]
  hv_avail_monitor                      = local.m_273["hv_avail_monitor"]
  mcast_addr                            = local.m_273["mcast_addr"]
  mode                                  = local.m_273["mode"]
  multicast_address                     = local.m_273["multicast_address"]
  name                                  = local.m_273["name"]
  name_alias                            = local.m_273["name_alias"]
  owner_key                             = local.m_273["owner_key"]
  owner_tag                             = local.m_273["owner_tag"]
  parent_dn                             = local.m_273["parent_dn"]
  pref_encap_mode                       = local.m_273["pref_encap_mode"]
  provider_profile_dn                   = local.m_273["provider_profile_dn"]
  relation_infra_rs_dom_vxlan_ns_def    = local.m_273["relation_infra_rs_dom_vxlan_ns_def"]
  relation_infra_rs_vip_addr_ns         = local.m_273["relation_infra_rs_vip_addr_ns"]
  relation_infra_rs_vlan_ns             = local.m_273["relation_infra_rs_vlan_ns"]
  relation_infra_rs_vlan_ns_def         = local.m_273["relation_infra_rs_vlan_ns_def"]
  relation_to_ip_address_pool           = local.m_273["relation_to_ip_address_pool"]
  relation_to_lacp_enhanced_lag_policy  = local.m_273["relation_to_lacp_enhanced_lag_policy"]
  relation_to_multicast_pool            = local.m_273["relation_to_multicast_pool"]
  relation_to_vlan_pool                 = local.m_273["relation_to_vlan_pool"]
  relation_vmm_rs_default_cdp_if_pol    = local.m_273["relation_vmm_rs_default_cdp_if_pol"]
  relation_vmm_rs_default_fw_pol        = local.m_273["relation_vmm_rs_default_fw_pol"]
