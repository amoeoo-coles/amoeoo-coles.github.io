  relation_vmm_rs_default_lacp_lag_pol  = local.m_273["relation_vmm_rs_default_lacp_lag_pol"]
  relation_vmm_rs_default_lldp_if_pol   = local.m_273["relation_vmm_rs_default_lldp_if_pol"]
  relation_vmm_rs_default_stp_if_pol    = local.m_273["relation_vmm_rs_default_stp_if_pol"]
  relation_vmm_rs_dom_mcast_addr_ns     = local.m_273["relation_vmm_rs_dom_mcast_addr_ns"]
  relation_vmm_rs_pref_enhanced_lag_pol = local.m_273["relation_vmm_rs_pref_enhanced_lag_pol"]
  switch_type                           = local.m_273["switch_type"]
  switching_enforcement_preference      = local.m_273["switching_enforcement_preference"]
  tags                                  = local.m_273["tags"]
