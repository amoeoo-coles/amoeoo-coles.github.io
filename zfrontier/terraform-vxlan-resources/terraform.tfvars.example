# Copy to terraform.tfvars (never commit the real file) or use TF_VAR_* env vars.
nxos_url             = "https://leaf1.example.com"
nxos_username        = "{{ nxos_username }}"
nxos_password        = "{{ nxos_password }}"
ndfc_url             = "https://nd.example.com"
ndfc_username        = "{{ ndfc_username }}"
ndfc_password        = "{{ ndfc_password }}"
ndfc_domain          = "local"
insecure             = false
ndfc_switch_username = "{{ ndfc_switch_username }}"
ndfc_switch_password = "{{ ndfc_switch_password }}"
