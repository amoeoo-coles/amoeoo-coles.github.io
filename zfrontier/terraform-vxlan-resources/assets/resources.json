 "nxos_total": 61,
 "ndfc_total": 19,
 "groups": [
  {
   "id": "global",
   "title": "1. Global, fabric and features",
   "intro": "Fabric-wide and switch-wide settings that come first: NX-OS features, system and platform (NVE/TCAM) settings, and NDFC fabric creation plus switch inventory.",
   "count": 7
  },
  {
   "id": "underlay",
   "title": "2. Underlay",
   "intro": "Loopbacks, IPv4 addressing / static routes, IGP (OSPF or IS-IS), BFD and multicast underlay (PIM, MSDP anycast RP), plus NDFC fabric links.",
   "count": 8
  },
  {
   "id": "overlay",
   "title": "3. VTEP and overlay",
   "intro": "NVE interface (VTEP), BGP with the L2VPN EVPN address family, and global EVPN VNI route distinguisher / route target settings.",
   "count": 3
  },
  {
   "id": "vrf",
   "title": "4. VRFs and L3VNI",
   "intro": "Tenant VRFs with RD / route targets, route maps and prefix lists used for VRF redistribution, and NDFC VRFs.",
   "count": 3
  },
  {
   "id": "network",
   "title": "5. Networks and L2VNI",
   "intro": "VLAN-to-VNI bridge domains, anycast gateway (HMM), SVIs, IGMP snooping for VXLAN, DHCP relay, and NDFC networks.",
   "count": 6
  },
  {
   "id": "access",
   "title": "6. Interfaces and access",
   "intro": "Physical, vPC, port-channel and sub-interfaces, spanning-tree edge settings, NDFC vPC pairs and NDFC interface resources.",
   "count": 11
  },
  {
   "id": "day2",
   "title": "7. Day 2 and operations",
   "intro": "Generic DME / CLI / REST escape hatches, NDFC templates and policies, configuration deploy and saving the running config.",
   "count": 7
  },
  {
   "id": "other",
   "title": "8. Other",
   "intro": "NDFC resources that are not VXLAN EVPN fabrics (IP Fabric for Media and LAN Classic fabric types). Included because every ndfc resource is in scope.",
   "count": 2
  }
 ],
